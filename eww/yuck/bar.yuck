; DankBar: a floating top bar of pill widgets (DMS default layout).
;   left:   launcher · workspaces · focused window
;   center: music · clock · weather
;   right:  tray · clipboard · cpu · ram · notifications · battery · control center

(defwindow bar [monitor floating]
  :geometry (geometry :anchor "top center" :width "100%" :height "${floating ? 42 : 38}px")
  :stacking "fg" :exclusive true :focusable "none" :namespace "dmr-bar"
  (box :class "bar-outer ${floating ? 'floating' : 'flush'}"
    (centerbox :class "dbar"
      (box :class "bar-section" :halign "start" :space-evenly false :spacing 4 (bar-left))
      (box :class "bar-section" :halign "center" :space-evenly false :spacing 4 (bar-center))
      (box :class "bar-section" :halign "end" :space-evenly false :spacing 4 (bar-right)))))

; bar-left/center/right are generated by the daemon into _gen.yuck from
; `bar.left/center/right`, so only the widgets in use are ever built.

; Pill surface. Size/margins live on the inner box: eventbox ignores them.
(defwidget pill [?onclick ?onrightclick ?onscroll ?class ?active]
  (eventbox :cursor "pointer" :onclick {onclick ?: ""} :onrightclick {onrightclick ?: ""} :onscroll {onscroll ?: ""}
    (box :class "pill ${class ?: ''} ${active == true ? 'active' : ''}" :space-evenly false :valign "center"
      (box :class "pill-in" :halign "center" :hexpand true :space-evenly false
        (children)))))

(defwidget bar-icon-pill [icon onclick ?active]
  (pill :onclick onclick :class "square" :active active
    (icon :name icon :size 16 :class "bar-icon")))

(defwidget bar-launcher []
  (pill :onclick "dmr toggle launcher" :class "square"
    (icon :name "apps" :size 18 :class "bar-icon")))

; Workspaces = driftwm bookmarks. Active: wide primary pill; occupied: brighter.
(defwidget bar-workspaces []
  (pill :class "ws-pill" :onscroll "dmr ws-scroll {}"
    (box :class "ws-row" :space-evenly false :spacing 6 :valign "center"
      (box :visible {arraylength(wm.workspaces) == 0}
        (box :class "ws active" :valign "center"))
      (for w in {wm.workspaces}
        (eventbox :cursor "pointer" :onclick "dmr ws idx ${w.i}"
          (box :class "ws ${w.active ? 'active' : (w.occupied ? 'occupied' : '')}" :valign "center"))))))

(defwidget bar-focused []
  (box :visible {wm.window.app != ""}
    (pill :class "focused"
      (image :class "focused-icon" :icon {wm.window.appIcon != "" ? wm.window.appIcon : "application-x-executable"} :icon-size "menu")
      (label :class "focused-app" :text {wm.window.appName} :limit-width 20)
      (label :class "dot" :text "•")
      (label :class "focused-title" :text {wm.window.title} :limit-width 46))))

(defwidget bar-music []
  (pill :class "music" :onclick "dmr toggle dash" :onrightclick "dmr media play-pause"
    (icon :name {media.playing ? "graphic_eq" : "music_note"} :size 16 :class "music-icon")
    (label :class "music-text" :limit-width 34
           :text "${media.title}${media.artist != '' ? ' • ' + media.artist : ''}")
    (box :class "music-ctl" :space-evenly false
      (button :class "mini" :onclick "dmr media previous" (icon :name "skip_previous" :fill true :size 16))
      (button :class "mini play" :onclick "dmr media play-pause" (icon :name {media.playing ? "pause" : "play_arrow"} :fill true :size 16))
      (button :class "mini" :onclick "dmr media next" (icon :name "skip_next" :fill true :size 16)))))

(defwidget bar-clock []
  (pill :class "clock ${ui.dash && ui.dashTab == 0 ? 'active' : ''}" :onclick "dmr dash-tab 0; dmr toggle dash"
    (label :class "clock-time" :text "${clock.hm}${clock.ampm != '' ? ' ' + clock.ampm : ''}")
    (label :class "dot" :text "•")
    (label :class "clock-date" :text {clock.date})))

(defwidget bar-weather []
  (pill :class "weather" :onclick "dmr dash-tab 3; dmr toggle dash"
    (icon :name {info.weather.available ? info.weather.icon : "clear_day"} :size 16 :class "bar-icon")
    (label :class "weather-temp" :text {info.weather.available ? info.weather.temp : "--°C"})))

(defwidget bar-tray []
  (box :class "tray-wrap"
    (systray :class "tray" :icon-size 16 :spacing 6 :prepend-new true)))

(defwidget bar-music-slot []
  (box :visible {media.available} (bar-music)))
(defwidget bar-clipboard []
  (bar-icon-pill :icon "content_paste" :onclick "dmr-clipboard &"))
(defwidget bar-cpu []
  (bar-stat :icon "memory" :value {load.cpu}))
(defwidget bar-mem []
  (bar-stat :icon "memory_alt" :value {load.mem}))
(defwidget bar-idle []
  (bar-icon-pill :icon {status.idleInhibit ? "coffee" : "coffee"} :active {status.idleInhibit} :onclick "dmr idle-inhibit"))
(defwidget bar-power []
  (bar-icon-pill :icon "power_settings_new" :onclick "dmr toggle powermenu"))

(defwidget bar-stat [icon value]
  (pill :class "stat" :onclick "dmr toggle controlcenter"
    (icon :name icon :size 16 :class "bar-icon")
    (label :class "stat-value" :text "${value}%")))

(defwidget bar-notifs []
  (pill :class "square ${ui.notifcenter ? 'active' : ''}" :onclick "dmr toggle notifcenter"
    (overlay
      (icon :name {status.dnd ? "notifications_off" : "notifications"} :size 16 :class "bar-icon")
      (box :visible {notifs.count > 0 && !status.dnd} :class "badge" :halign "end" :valign "start"))))

(defwidget bar-battery []
  (pill :class "battery ${status.bat.present && status.bat.pct <= 20 && !status.bat.charging ? 'low' : ''} ${status.bat.present ? '' : 'square'}"
        :onclick "dmr toggle controlcenter"
    (icon :name {status.bat.present ? status.bat.icon : "power"} :size 16 :class "bar-icon")
    (box :visible {status.bat.present}
      (label :class "stat-value" :text "${status.bat.pct}%"))))

; Control center button: network · bluetooth · volume, like DMS.
(defwidget bar-cc []
  (pill :class "cc-btn ${ui.controlcenter ? 'active' : ''} ${status.net.connected || status.bt.connected > 0 ? '' : 'square'}"
        :onclick "dmr toggle controlcenter"
        :onscroll "dmr volume {}"
    (box :visible {status.net.connected} (icon :name {status.net.icon} :size 16 :class "bar-icon"))
    (box :visible {status.bt.connected > 0} (icon :name "bluetooth" :size 16 :class "bar-icon"))
    (icon :name {status.audio.icon} :size 16 :class "bar-icon")))
